{
  "name": "codex-quota-dashboard",
  "version": "1.0.9",
  "description": "A compact Windows 11 dashboard for Codex quota and DeepSeek balances.",
  "type": "module",
  "main": "app/main.js",
  "author": "doraasn",
  "license": "MIT",
  "repository": "https://github.com/doraasn/codex-quota-dashboard",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "smoke": "electron scripts/smoke.cjs",
    "verify": "npm test && npm run smoke",
    "dist": "node scripts/build.mjs"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.doraasn.codexquotadashboard",
    "productName": "Codex Quota Dashboard",
    "executableName": "CodexQuotaDashboard",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/tray.png",
        "to": "tray.png"
      }
    ],
    "artifactName": "CodexQuotaDashboard-${version}-${arch}.${ext}",
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "portable"
      ]
    }
  }
}
